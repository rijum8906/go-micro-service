model
    schema 1.1

type user

type organization
    relations
        define admin: [user]
        define member: [user]
        define owner: [user]

        define can_update_organization: owner
        define can_delete_organization: owner
        define can_add_organzation_memebr: owner or admin
        define can_remove_oranization_memebr: owner or admin
        define can_view_organization_members: owner or admin or member

type custom_role
      relations
        define parent: [organization]
        define assignee: [user]
