model
  schema 1.1

type user

type organization
  relations
    # Direct Roles
    define owner: [user]
    define admin: [user]
    define member: [user]

    # Permission Logic
    define can_delete: owner
    define can_edit: can_delete or admin
    define can_add_member: can_edit
    define can_remove_member: can_add_member
    define can_view_member: owner or admin or member
    define can_create_team: owner or admin or member

type team
  relations
    define parent_org: [organization]
    define leader: [user]
    define member: [user]

    # Inheritance: Org Owners/Admins are implicitly Team Leads
    define can_delete: leader or owner from parent_org
    define can_edit: can_delete
    define can_add_member: leader or admin from parent_org
    define can_remove_member: can_add_member
    define can_view_member: leader or admin from parent_org or member
