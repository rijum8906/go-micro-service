type Token {
  value: String!
  expiresAt: DateTime!
}

type AuthTokens {
  accessToken: Token!
  refreshToken: Token!
}

type AuthResponse {
  tokens: AuthTokens!
  user: User!
  profile: Profile!
}

type MutationResponse {
   success: Boolean!
   message: String!
 }

 type ScopedTokenResponse {
   token: Token!
 }
