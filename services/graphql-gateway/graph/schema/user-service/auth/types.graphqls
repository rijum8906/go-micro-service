type AuthAccount {
    id: UUID!
    email: Email!
}

type Token {
  value: String!
  expiresAt: DateTime
}

type AuthToken {
    accessToken: String!
    refreshToken: String!
}

type AuthProfile {
  id: String!
  firstName: String!
  lastName: String!
  displayName: String
  avatarUrl: String
}

type AuthPayload {
    account: AuthAccount!
    tokens: AuthToken!
    profiles: [AuthProfile!]!
}

