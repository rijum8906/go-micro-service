set shell := ["zsh", "-c"]
set dotenv-load := true

# --- Variables ---

# Database connection string inherited from environment or defaulted
export DB_URL := env_var_or_default("DATABASE_URL", "postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable")
export MIGRATION_DIR := "internal/db/migrations"
export MINIO_PORT := env_var_or_default("MINIO_PORT", "9000")
export MINIO_CONSOLE_PORT := env_var_or_default("MINIO_CONSOLE_PORT", "9001")
export MINIO_ROOT_USER := env_var_or_default("MINIO_ROOT_USER", "admin")
export MINIO_ROOT_PASSWORD := env_var_or_default("MINIO_ROOT_PASSWORD", "password123")

# --- Build & Execution ---
# Start MinIO server locally
minio-up:
    @mkdir -p "$HOME/minio_data"
    @echo "Starting MinIO server..."
    @echo "Console available at http://localhost:${MINIO_CONSOLE_PORT}"
    MINIO_ROOT_USER="${MINIO_ROOT_USER}" MINIO_ROOT_PASSWORD="${MINIO_ROOT_PASSWORD}" minio server "$HOME/minio_data" --console-address ":${MINIO_CONSOLE_PORT}" &

# Setup the MinIO client (mcli) and create initial bucket
minio-setup:
    mcli alias set local http://localhost:"${MINIO_PORT}" "${MINIO_ROOT_USER}" "${MINIO_ROOT_PASSWORD}"
    mcli mb local/avatars
    mcli anonymous set public local/avatars

# Build the service binary
build:
    @echo "Building user-service..."
    go build -o ./bin/user-service ./cmd/main.go

# Build and then run the binary
run: build
    @echo "Starting user-service..."
    ./bin/user-service

# Development run with hot reload 
dev:
    air

# Setup
setup:
    go mod tidy

# --- Database & Tools ---

# Apply database migrations
migrate-up:
    goose -dir {{MIGRATION_DIR}} postgres "${DB_URL}" up

# Create a new migration file (usage: just create-migration name)
create-migration name:
    goose -dir {{MIGRATION_DIR}} create {{name}} sql

# Generate Go code using sqlc
sqlc:
    sqlc generate

# --- Infrastructure ---

# Start local infrastructure (systemd)
infra-start: minio-up
    sudo systemctl start postgresql redis

# Stop core services [cite: 1]
infra-stop:
    sudo systemctl stop postgresql redis
