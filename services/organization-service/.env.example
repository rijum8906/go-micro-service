# --------------------------------- App Info ----------------------------------
APP_NAME=organization-service
APP_ENV=development
PORT=8084

# --------------------------------- Database ----------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=organization_service
DB_SSL_MODE=disable

# --------------------------------- Redis ----------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=


# --------------------------------- JWT ----------------------------------
JWT_ISSUER=user-service
JWT_SECRET=your_super_secret_jwt_key_here
SCOPED_SECRET=your_super_secret_scoped_key_here

# --------------------------------- Logger ----------------------------------
LOG_LEVEL=info
LOG_FILE=
ENABLE_JSON=false
ENABLE_STACK=true
ENABLE_CALLER=true

# --------------------------------- TTL ----------------------------------
SESSION_TTL=15m
SCOPED_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h

# --------------------------------- FGA ----------------------------------
OPENFGA_API_URL=http://openfga:8000
OPENFGA_TEST_API_URL=http://localhost:9000
OPENFGA_TEST_STORE_ID=01KQW7VYB1SH6C7105JYSZYXF8
